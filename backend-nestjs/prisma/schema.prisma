// =============================================================================
// Esquema Prisma — Supabase / PostgreSQL (21 tablas)
// Fuente: "base de datos-documentacion.md" sección 3.
//
//  * Los modelos conservan EXACTAMENTE el nombre de tabla y de columna de la BD
//    (equivale a lo que produciría `prisma db pull`), por eso no hay @@map.
//  * int8  -> BigInt          (la capa HTTP lo convierte a number: JsonSerializationInterceptor)
//  * numeric -> Decimal       (Prisma.Decimal / decimal.js; PROHIBIDO number en cálculos monetarios)
//  * Triggers y SPs viven en la BD; Prisma no los gestiona. No se usa `prisma migrate`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio 1: Identidad, autenticación y contactos
// ─────────────────────────────────────────────────────────────────────────────

model Users {
  id               BigInt   @id @default(autoincrement())
  email            String   @unique
  password_hash    String?  @db.VarChar
  role             String   @db.VarChar
  name             String?
  avatar_url       String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  provider         String?
  provider_user_id String?

  linked_accounts            linked_accounts[]
  personas_owned             Personas[]                 @relation("PersonasOwner")
  personas_linked            Personas[]                 @relation("PersonasLinkedUser")
  tarjetas                   Tarjetas[]
  tarjeta_plasticos          TarjetaPlasticos[]
  compras_credito            ComprasCredito[]
  cuentas_financieras        CuentasFinancieras[]
  categorias                 Categorias[]
  transacciones              Transacciones[]
  notificaciones_correo      NotificacionesCorreo[]
  plantillas_recurrentes     PlantillasRecurrentes[]
  periodos_recurrentes       PeriodosRecurrentes[]
  cortes_cobro               CortesCobro[]
  prestamos                  Prestamos[]
  obligaciones_mes           ObligacionesMes[]
  cruces_deuda               CrucesDeuda[]
  movimientos_deuda          MovimientosDeudaPersona[]
  cargos_recurrentes_persona CargosRecurrentesPersona[]
  cobros_puntuales           CobrosPuntuales[]
  enlaces_cobro              EnlacesCobroPersona[]
  reportes_pago              ReportesPagoPersona[]
  metodos_pago               MetodosPagoUsuario[]
  objeciones_cobro           ObjecionesCobro[]
  etiquetas                  Etiquetas[]
  reglas_auto_tag            ReglasAutoTag[]
  eventos_grupales           EventosLiquidacionGrupal[]
  abonos_prestamos_pasivos   AbonosPrestamoPasivo[]
}

model Etiquetas {
  id              BigInt   @id @default(autoincrement())
  owner_user_id   BigInt
  slug            String   @db.VarChar(80)
  nombre          String   @db.VarChar(120)
  color           String?  @db.VarChar(30)
  icono           String?  @db.VarChar(60)
  tipo_agrupacion String   @default("HABITO") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  owner Users @relation(fields: [owner_user_id], references: [id])

  @@unique([owner_user_id, slug])
}

model ReglasAutoTag {
  id                       BigInt   @id @default(autoincrement())
  owner_user_id            BigInt
  patron_comercio_regex    String?  @db.VarChar(500)
  patron_descripcion_regex String?  @db.VarChar(500)
  monto_min                Decimal? @db.Decimal(15, 2)
  monto_max                Decimal? @db.Decimal(15, 2)
  comercio_canonico        String?  @db.VarChar(120)
  tags_slugs               String[] @default([])
  prioridad                Int      @default(100)
  activo                   Boolean  @default(true)
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  owner Users @relation(fields: [owner_user_id], references: [id])
}

model linked_accounts {
  id               BigInt   @id @default(autoincrement())
  user_id          BigInt
  provider_key     String   @db.VarChar
  provider_user_id String
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  user Users @relation(fields: [user_id], references: [id])
}

model Personas {
  id                   BigInt   @id @default(autoincrement())
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  nombre               String?  @db.VarChar
  iniciales_nombre     String?
  color_representativo String?
  owner_user_id        BigInt?
  linked_user_id       BigInt?
  appsheet_row_id      String?  @unique
  email                String?
  numero_celular       String?  @db.VarChar
  legacy_appsheet_id   String?  @unique @db.VarChar

  owner       Users? @relation("PersonasOwner", fields: [owner_user_id], references: [id])
  linked_user Users? @relation("PersonasLinkedUser", fields: [linked_user_id], references: [id])

  responsables_compras     ResponsablesComprasCredito[]
  prestamos_deudor         Prestamos[]                  @relation("PrestamoResponsable")
  prestamos_creados        Prestamos[]                  @relation("PrestamoCreadoPor")
  aprobaciones             AprobacionesPrestamos[]
  obligaciones             ObligacionesMes[]
  aportes                  AportesDetalle[]
  cruces_abona             CrucesDeuda[]                @relation("CruceAbona")
  cruces_asume             CrucesDeuda[]                @relation("CruceAsume")
  responsables_recurrentes ResponsablesRecurrentes[]
  movimientos              MovimientosDeudaPersona[]
  cargos_recurrentes       CargosRecurrentesPersona[]
  cobros_puntuales         CobrosPuntualesPersonas[]
  enlaces_cobro            EnlacesCobroPersona[]
  reportes_pago            ReportesPagoPersona[]
  objeciones_cobro         ObjecionesCobro[]
  notificaciones           NotificacionesCorreo[]
  participaciones_eventos  ParticipantesEventoGrupal[]
  tarjetas_titular_externo Tarjetas[]                   @relation("TarjetaTitularExterno")
  aportes_colaborativos    AportesColaborativosCuota[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio 2: Tarjetas de crédito y compras diferidas
// ─────────────────────────────────────────────────────────────────────────────

model Tarjetas {
  id                         BigInt    @id @default(autoincrement())
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  franquicia                 String?   @db.VarChar
  descripcion                String?   @db.VarChar
  tasa_interes_compra        Decimal?  @db.Decimal
  tasa_interes_avance        Decimal?  @db.Decimal
  cuota_manejo               Decimal?  @db.Decimal
  url_info                   String?
  ultima_actualizacion_tasas DateTime? @db.Timestamp(6)
  extract_tasas              Boolean   @default(false)
  owner_user_id              BigInt?
  dia_corte                  Int?      @db.SmallInt
  dia_limite_pago            Int?      @db.SmallInt
  cupo_total                 Decimal?  @db.Decimal
  permite_dolares            Boolean?
  /// Últimos 4 dígitos con los que el banco identifica la tarjeta; admite varios ("1927,9587") si se reexpidió (sql/003).
  ultimos_4_digitos          String?
  /// CREDITO | DEBITO (sql/006). Una tarjeta de débito siempre cuelga de una cuenta.
  tipo_tarjeta               String    @default("CREDITO") @db.VarChar(7)
  /// Cuenta a la que pertenece (obligatoria en débito; en crédito, la que la paga, opcional). Una cuenta puede tener varias tarjetas.
  cuenta_id                  BigInt?
  /// Nombre corto para mostrar («Débito *3698»).
  alias                      String?   @db.VarChar
  /// Producto que recibe lo que el banco avisa SIN los últimos 4 dígitos («Crédito sin número»).
  es_generica                Boolean   @default(false)
  /// Tarjeta prestada/de un tercero (sql/013, Fase 5): no suma al cupo propio; genera obligación hacia el titular.
  es_titular_externo         Boolean   @default(false)
  titular_persona_id         BigInt?

  owner  Users?              @relation(fields: [owner_user_id], references: [id])
  cuenta CuentasFinancieras? @relation("TarjetaCuenta", fields: [cuenta_id], references: [id], onDelete: Restrict)
  titular Personas?          @relation("TarjetaTitularExterno", fields: [titular_persona_id], references: [id])

  compras               ComprasCredito[]
  transacciones_pagadas Transacciones[]
  plantillas_default    PlantillasRecurrentes[]
  notificaciones        NotificacionesCorreo[]
  plasticos             TarjetaPlasticos[]
}

/// Cada plástico (reposición/renovación) de una línea de crédito (`Tarjetas`). Un solo plástico activo por tarjeta (sql/004).
model TarjetaPlasticos {
  id               BigInt    @id @default(autoincrement())
  tarjeta_id       BigInt
  owner_user_id    BigInt?
  ultimos_4        String    @db.VarChar(4)
  es_activo        Boolean   @default(true)
  vigente_desde    DateTime? @db.Date
  vigente_hasta    DateTime? @db.Date
  /// VENCIMIENTO | PERDIDA | ROBO | DETERIORO | FRAUDE | CAMBIO_PRODUCTO | OTRO — por qué se reemplazó el plástico ANTERIOR.
  motivo_reemplazo String?   @db.VarChar(20)
  reemplaza_a_id   BigInt?
  notas            String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  tarjeta         Tarjetas           @relation(fields: [tarjeta_id], references: [id], onDelete: Cascade)
  owner           Users?             @relation(fields: [owner_user_id], references: [id])
  reemplaza_a     TarjetaPlasticos?  @relation("PlasticoReemplazo", fields: [reemplaza_a_id], references: [id])
  reemplazado_por TarjetaPlasticos[] @relation("PlasticoReemplazo")
  compras         ComprasCredito[]

  @@unique([tarjeta_id, ultimos_4])
}

model ComprasCredito {
  id                    BigInt    @id @default(autoincrement())
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  concepto              String?   @db.VarChar
  valor_compra          Decimal?  @db.Decimal
  fecha_compra          DateTime? @db.Date
  numero_cuotas         Int?      @db.SmallInt
  fecha_ultima_cuota    DateTime? @db.Date
  pago_mensual          Decimal?  @db.Decimal
  interes               Decimal?  @db.Decimal
  descripcion           String?   @db.VarChar
  estado                String?   @db.VarChar
  tarjeta               BigInt?
  owner_user_id         BigInt?
  moneda_original       String    @default("COP") @db.Char(3)
  valor_moneda_original Decimal?  @db.Decimal
  tasa_cambio_aplicada  Decimal?  @db.Decimal
  trm_confirmada        Boolean?
  /// Plástico con el que se hizo la compra, si se sabe (sql/004). NULL = no registrado (la API lo infiere por fecha).
  plastico_id           BigInt?
  /// En una compra ABSORBIDA por un refinanciamiento: la compra maestra que la unificó (sql/009). NULL = no absorbida.
  refinanciamiento_id   BigInt?
  /// La compra es la obligación nueva que unifica a otras (sql/009).
  es_refinanciamiento   Boolean   @default(false)
  /// En una absorbida: el capital pendiente que se llevó la maestra.
  saldo_refinanciado    Decimal?  @db.Decimal
  /// CAPITAL_FIJO (compras normales) | FRANCES (cuota fija, como los refinanciamientos del banco).
  sistema_amortizacion  String    @default("CAPITAL_FIJO") @db.VarChar(12)
  /// Cuota que dio el banco cuando difiere de la calculada (incluye seguros o ajustes).
  cuota_fija_pactada    Decimal?  @db.Decimal
  /// Tags transversales (sql/011, Fase 2): slugs con '#', p. ej. ['#domicilios','#rappi'].
  tags                  String[]  @default([])
  comercio_canonico     String?   @db.VarChar(120)

  tarjeta_ref Tarjetas?         @relation(fields: [tarjeta], references: [id])
  owner       Users?            @relation(fields: [owner_user_id], references: [id])
  plastico    TarjetaPlasticos? @relation(fields: [plastico_id], references: [id])
  /// La maestra que absorbió a esta compra y las compras que absorbió esta (si es maestra).
  refinanciamiento ComprasCredito?  @relation("Refinanciamiento", fields: [refinanciamiento_id], references: [id], onDelete: SetNull)
  absorbidas       ComprasCredito[] @relation("Refinanciamiento")

  cuotas           CuotasDetalle[]
  aportes_colaborativos AportesColaborativosCuota[]
  responsables     ResponsablesComprasCredito[]
  notificaciones   NotificacionesCorreo[]
  periodos_pagados PeriodosRecurrentes[]
  cobros_puntuales CobrosPuntuales[]
}

model CuotasDetalle {
  id                  BigInt    @id @default(autoincrement())
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  numero_cuota        BigInt?
  fecha_pago          DateTime? @db.Date
  saldo_restante      Decimal?  @db.Decimal
  interes_pagado      Decimal?  @db.Decimal
  aporte_capital      Decimal?  @db.Decimal
  pago_total          Decimal?  @db.Decimal
  compra              BigInt?
  estado              String?
  periodo_facturacion String?   @db.Char(7)

  compra_ref ComprasCredito? @relation(fields: [compra], references: [id])

  movimientos MovimientosDeudaPersona[]
  aportes_colaborativos AportesColaborativosCuota[]
}

model ResponsablesComprasCredito {
  id              BigInt   @id @default(autoincrement())
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  persona         BigInt?
  porcentaje_pago Decimal? @db.Decimal
  cantidad_pago   Decimal? @db.Decimal
  cantidad_cuotas Int?     @db.SmallInt
  compra_credito  BigInt?

  persona_ref        Personas?       @relation(fields: [persona], references: [id])
  compra_credito_ref ComprasCredito? @relation(fields: [compra_credito], references: [id])

  movimientos MovimientosDeudaPersona[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio 3: Cuentas, categorías, transacciones y correos bancarios
// ─────────────────────────────────────────────────────────────────────────────

model CuentasFinancieras {
  id                BigInt    @id @default(autoincrement())
  owner_user_id     BigInt
  nombre            String    @db.VarChar
  tipo_cuenta       String    @db.VarChar
  banco_entidad     String?   @db.VarChar
  ultimos_4_digitos String?   @db.VarChar
  moneda            String    @default("COP") @db.Char(3)
  saldo_actual      Decimal   @default(0) @db.Decimal
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  /// Cuenta que recibe los avisos del banco que no traen número (p. ej. la nómina). Una por usuario (sql/003).
  es_principal      Boolean   @default(false)
  /// Cuenta «sin número» que recibe los avisos del banco que no traen cuenta (sql/006).
  es_generica       Boolean   @default(false)
  /// Periodo en que se ha usado la cuenta (para la línea de tiempo); NULL = sin cierre.
  fecha_inicio_uso  DateTime? @db.Date
  fecha_fin_uso     DateTime? @db.Date

  owner    Users      @relation(fields: [owner_user_id], references: [id])
  tarjetas Tarjetas[] @relation("TarjetaCuenta")

  transacciones_origen  Transacciones[]         @relation("TxCuentaOrigen")
  transacciones_destino Transacciones[]         @relation("TxCuentaDestino")
  plantillas_debito     PlantillasRecurrentes[]
  aportes_detalle       AportesDetalle[]
  notificaciones        NotificacionesCorreo[]
  reportes_pago         ReportesPagoPersona[]
  metodos_pago          MetodosPagoUsuario[]
  transacciones_contraparte Transacciones[]        @relation("TxCuentaContraparte")
  prestamos_desembolso      Prestamos[]            @relation("PrestamoCuentaDesembolso")
  abonos_prestamos_pasivos AbonosPrestamoPasivo[]
}

model Categorias {
  id            BigInt    @id @default(autoincrement())
  owner_user_id BigInt?
  nombre        String    @db.VarChar
  tipo          String    @db.VarChar
  icono         String?
  color         String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  owner Users? @relation(fields: [owner_user_id], references: [id])

  transacciones Transacciones[]
  plantillas    PlantillasRecurrentes[]
}

model Transacciones {
  id                BigInt    @id @default(autoincrement())
  owner_user_id     BigInt
  tipo_transaccion  String    @db.VarChar
  cuenta_origen_id  BigInt?
  cuenta_destino_id BigInt?
  tarjeta_pagada_id BigInt?
  categoria_id      BigInt?
  fecha_transaccion DateTime  @default(now()) @db.Timestamptz(6)
  concepto          String    @db.VarChar
  moneda_original   String    @default("COP") @db.Char(3)
  monto_original    Decimal   @db.Decimal
  tasa_cambio       Decimal   @default(1.0) @db.Decimal
  monto_cop         Decimal   @db.Decimal
  origen_registro   String?   @db.VarChar
  estado            String?   @db.VarChar
  notas             String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  /// Tags transversales (sql/011, Fase 2).
  tags              String[]            @default([])
  comercio_canonico String?             @db.VarChar(120)
  es_transferencia_interna Boolean      @default(false)
  cuenta_contraparte_id    BigInt?
  transaccion_espejo_id    BigInt?

  owner          Users               @relation(fields: [owner_user_id], references: [id])
  cuenta_origen  CuentasFinancieras? @relation("TxCuentaOrigen", fields: [cuenta_origen_id], references: [id])
  cuenta_destino CuentasFinancieras? @relation("TxCuentaDestino", fields: [cuenta_destino_id], references: [id])
  tarjeta_pagada Tarjetas?           @relation(fields: [tarjeta_pagada_id], references: [id])
  categoria      Categorias?         @relation(fields: [categoria_id], references: [id])

  notificaciones   NotificacionesCorreo[]
  periodos_pago    PeriodosRecurrentes[]
  movimientos      MovimientosDeudaPersona[]
  aportes_detalle  AportesDetalle[]
  cobros_puntuales CobrosPuntuales[]
  reportes_pago    ReportesPagoPersona[]
  cuenta_contraparte CuentasFinancieras? @relation("TxCuentaContraparte", fields: [cuenta_contraparte_id], references: [id], onDelete: SetNull)
  transaccion_espejo Transacciones?      @relation("TxEspejo", fields: [transaccion_espejo_id], references: [id], onDelete: SetNull)
  espejo_inverso     Transacciones[]     @relation("TxEspejo")
  prestamos_desembolso Prestamos[]       @relation("PrestamoTxDesembolso")
  aportes_colaborativos AportesColaborativosCuota[]
  abonos_prestamos_pasivos AbonosPrestamoPasivo[]
}

model NotificacionesCorreo {
  id                         BigInt    @id @default(autoincrement())
  owner_user_id              BigInt
  external_message_id        String    @unique @db.VarChar
  remitente                  String?   @db.VarChar
  asunto                     String?
  fecha_correo               DateTime  @db.Timestamptz(6)
  cuerpo_extraido            String?
  datos_parseados            Json?
  estado_procesamiento       String?   @db.VarChar
  transaccion_generada_id    BigInt?
  compra_credito_generada_id BigInt?
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  /// Columnas indexables que rellena el sync-batch / el reproceso (sql/003).
  ultimos_4                  String?   @db.VarChar(4)
  comercio_normalizado       String?   @db.VarChar
  monto_original             Decimal?  @db.Decimal(18, 4)
  moneda                     String?   @db.Char(3)
  tarjeta_id                 BigInt?
  cuenta_id                  BigInt?
  persona_id                 BigInt?
  /// CREADA = la app registró la compra/transacción; EXISTENTE = ya existía y se enlazó; DUPLICADO = otro correo del mismo hecho.
  vinculo                    String?   @db.VarChar(12)
  notificacion_original_id   BigInt?

  owner                Users                  @relation(fields: [owner_user_id], references: [id])
  transaccion_generada Transacciones?         @relation(fields: [transaccion_generada_id], references: [id])
  compra_generada      ComprasCredito?        @relation(fields: [compra_credito_generada_id], references: [id])
  tarjeta              Tarjetas?              @relation(fields: [tarjeta_id], references: [id])
  cuenta               CuentasFinancieras?    @relation(fields: [cuenta_id], references: [id])
  persona              Personas?              @relation(fields: [persona_id], references: [id])
  original             NotificacionesCorreo?  @relation("NotificacionDuplicada", fields: [notificacion_original_id], references: [id])
  duplicadas           NotificacionesCorreo[] @relation("NotificacionDuplicada")
  prestamos_asociados  Prestamos[]            @relation("PrestamoNotificacionCorreo")
  cobros_puntuales     CobrosPuntuales[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio 4: Gastos recurrentes y pronósticos
// ─────────────────────────────────────────────────────────────────────────────

model PlantillasRecurrentes {
  id                         BigInt    @id @default(autoincrement())
  owner_user_id              BigInt
  nombre                     String    @db.VarChar
  categoria_id               BigInt?
  frecuencia                 String?   @db.VarChar
  dia_vencimiento_estimado   Int?      @db.SmallInt
  es_monto_variable          Boolean?
  moneda                     String    @default("COP") @db.Char(3)
  monto_base_estimado        Decimal   @db.Decimal
  cuenta_debito_default_id   BigInt?
  tarjeta_credito_default_id BigInt?
  prestamo_asociado_id       BigInt?
  is_active                  Boolean?  @default(true)
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)

  owner             Users               @relation(fields: [owner_user_id], references: [id])
  categoria         Categorias?         @relation(fields: [categoria_id], references: [id])
  cuenta_debito     CuentasFinancieras? @relation(fields: [cuenta_debito_default_id], references: [id])
  tarjeta_default   Tarjetas?           @relation(fields: [tarjeta_credito_default_id], references: [id])
  prestamo_asociado Prestamos?          @relation(fields: [prestamo_asociado_id], references: [id])

  responsables ResponsablesRecurrentes[]
  periodos     PeriodosRecurrentes[]
}

model ResponsablesRecurrentes {
  id                       BigInt    @id @default(autoincrement())
  plantilla_recurrente_id  BigInt
  persona_id               BigInt?
  porcentaje_participacion Decimal?  @db.Decimal
  monto_fijo_participacion Decimal?  @db.Decimal
  created_at               DateTime? @default(now()) @db.Timestamptz(6)

  plantilla PlantillasRecurrentes @relation(fields: [plantilla_recurrente_id], references: [id])
  persona   Personas?             @relation(fields: [persona_id], references: [id])
}

model PeriodosRecurrentes {
  id                      BigInt    @id @default(autoincrement())
  plantilla_recurrente_id BigInt
  owner_user_id           BigInt
  periodo                 String    @db.Char(7)
  fecha_estimada_pago     DateTime  @db.Date
  monto_pronosticado      Decimal   @db.Decimal
  monto_real_pagado       Decimal?  @db.Decimal
  estado                  String?   @db.VarChar
  transaccion_pago_id     BigInt?
  compra_credito_pago_id  BigInt?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)

  plantilla   PlantillasRecurrentes @relation(fields: [plantilla_recurrente_id], references: [id])
  owner       Users                 @relation(fields: [owner_user_id], references: [id])
  transaccion Transacciones?        @relation(fields: [transaccion_pago_id], references: [id])
  compra_pago ComprasCredito?       @relation(fields: [compra_credito_pago_id], references: [id])

  movimientos MovimientosDeudaPersona[]
  cruces      CrucesDeuda[]

  @@unique([plantilla_recurrente_id, periodo], map: "uq_periodos_recurrentes_plantilla_periodo")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio 5: Préstamos, cortes, obligaciones mensuales y sub-ledger
// ─────────────────────────────────────────────────────────────────────────────

model CortesCobro {
  id                 BigInt    @id @default(autoincrement())
  owner_user_id      BigInt
  concepto           String    @db.VarChar
  fecha_inicio       DateTime  @db.Date
  fecha_final        DateTime  @db.Date
  estado             String?   @db.VarChar
  legacy_appsheet_id String?   @unique @db.VarChar
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  owner Users @relation(fields: [owner_user_id], references: [id])

  prestamos Prestamos[]
}

model Prestamos {
  id                     BigInt    @id @default(autoincrement())
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  valor_prestado         Decimal?  @db.Decimal
  concepto               String?   @db.VarChar
  fecha_cobro            DateTime? @db.Date
  responsable            BigInt?
  estado                 String?   @db.VarChar
  comentarios            String?   @db.VarChar
  owner_user_id          BigInt?
  direccion_prestamo     String?   @db.VarChar
  saldo_pendiente        Decimal?  @db.Decimal
  es_recurrente_mensual  Boolean?
  cuota_mensual_acordada Decimal?  @db.Decimal
  fecha_prestamo         DateTime? @db.Date
  metodo                 String?   @db.VarChar
  corte_id               BigInt?
  creado_por_persona_id  BigInt?
  origen_cruce_aporte_id BigInt?
  legacy_appsheet_id     String?   @unique @db.VarChar
  /// Fase 6 (sql/014): compromiso y destino cuando YO debo (POR_PAGAR) + token del portal del acreedor.
  fecha_compromiso_pago  DateTime? @db.Date
  cuenta_destino_tercero String?   @db.VarChar(150)
  token_consulta_publica String?   @unique @db.VarChar(64)
  transaccion_desembolso_id    BigInt?
  notificacion_correo_id       BigInt?
  cuenta_origen_desembolso_id  BigInt?

  owner               Users?          @relation(fields: [owner_user_id], references: [id])
  responsable_ref     Personas?       @relation("PrestamoResponsable", fields: [responsable], references: [id])
  creado_por          Personas?       @relation("PrestamoCreadoPor", fields: [creado_por_persona_id], references: [id])
  corte               CortesCobro?    @relation(fields: [corte_id], references: [id])
  origen_cruce_aporte AportesDetalle? @relation("PrestamoOrigenAporte", fields: [origen_cruce_aporte_id], references: [id])
  transaccion_desembolso   Transacciones?        @relation("PrestamoTxDesembolso", fields: [transaccion_desembolso_id], references: [id], onDelete: SetNull)
  notificacion_correo      NotificacionesCorreo? @relation("PrestamoNotificacionCorreo", fields: [notificacion_correo_id], references: [id], onDelete: SetNull)
  cuenta_origen_desembolso CuentasFinancieras?   @relation("PrestamoCuentaDesembolso", fields: [cuenta_origen_desembolso_id], references: [id], onDelete: SetNull)

  aprobaciones        AprobacionesPrestamos[]
  abonos_pasivos      AbonosPrestamoPasivo[]
  movimientos         MovimientosDeudaPersona[]
  plantillas          PlantillasRecurrentes[]
  cruces_destino      CrucesDeuda[]
  aportes_generadores AportesDetalle[]          @relation("AporteCruceGenerado")
}

model AprobacionesPrestamos {
  id                 BigInt    @id @default(autoincrement())
  prestamo_id        BigInt
  persona_id         BigInt
  estado             String    @db.VarChar
  comentarios        String?
  fecha_aprobacion   DateTime? @db.Timestamptz(6)
  legacy_appsheet_id String?   @unique @db.VarChar

  prestamo Prestamos @relation(fields: [prestamo_id], references: [id])
  persona  Personas  @relation(fields: [persona_id], references: [id])
}

model ObligacionesMes {
  id                       BigInt    @id @default(autoincrement())
  owner_user_id            BigInt
  tipo_obligacion          String    @db.VarChar
  responsable_principal_id BigInt
  concepto                 String    @db.VarChar
  periodo                  String    @db.Char(7)
  meta_mensual             Decimal   @db.Decimal
  fecha_inicio             DateTime  @db.Date
  fecha_final              DateTime? @db.Date
  estado                   String?   @db.VarChar
  legacy_appsheet_id       String?   @unique @db.VarChar
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  /// Parte del excedente del mes ya trasladada a otro mes o cruzada contra el estado de cuenta (sql/002).
  saldo_a_favor_aplicado   Decimal   @default(0) @db.Decimal(15, 2)

  owner                 Users    @relation(fields: [owner_user_id], references: [id])
  responsable_principal Personas @relation(fields: [responsable_principal_id], references: [id])

  dias                 AportesDia[]
  aportes_origen_saldo AportesDetalle[]          @relation("AporteOrigenSaldoFavor")
  movimientos_saldo    MovimientosDeudaPersona[]
}

model AportesDia {
  id                 BigInt    @id @default(autoincrement())
  obligacion_mes_id  BigInt
  fecha              DateTime  @db.Date
  notas              String?
  legacy_appsheet_id String?   @unique @db.VarChar
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  obligacion_mes ObligacionesMes @relation(fields: [obligacion_mes_id], references: [id])

  detalles AportesDetalle[]
}

model AportesDetalle {
  id                         BigInt    @id @default(autoincrement())
  aporte_dia_id              BigInt
  persona_id                 BigInt
  valor                      Decimal   @db.Decimal
  metodo                     String    @db.VarChar
  comentarios                String?
  prestamo_cruce_generado_id BigInt?
  legacy_appsheet_id         String?   @unique @db.VarChar
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  /// Cuenta donde entró el dinero (EFECTIVO / TRANSFERENCIA) y la transacción que se generó (sql/002).
  cuenta_financiera_id       BigInt?
  transaccion_id             BigInt?
  /// Periodo del que viene el saldo a favor cuando metodo = SALDO_A_FAVOR.
  origen_obligacion_mes_id   BigInt?

  aporte_dia     AportesDia          @relation(fields: [aporte_dia_id], references: [id])
  persona        Personas            @relation(fields: [persona_id], references: [id])
  prestamo_cruce Prestamos?          @relation("AporteCruceGenerado", fields: [prestamo_cruce_generado_id], references: [id])
  cuenta         CuentasFinancieras? @relation(fields: [cuenta_financiera_id], references: [id])
  transaccion    Transacciones?      @relation(fields: [transaccion_id], references: [id])
  origen_saldo   ObligacionesMes?    @relation("AporteOrigenSaldoFavor", fields: [origen_obligacion_mes_id], references: [id])

  prestamos_origen Prestamos[] @relation("PrestamoOrigenAporte")
}

model CrucesDeuda {
  id                            BigInt    @id @default(autoincrement())
  owner_user_id                 BigInt
  fecha_cruce                   DateTime  @db.Date
  persona_que_abona_id          BigInt
  persona_que_asume_deuda_id    BigInt
  monto                         Decimal   @db.Decimal
  prestamo_destino_id           BigInt?
  periodo_recurrente_destino_id BigInt?
  concepto                      String    @db.VarChar
  comentarios                   String?
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)

  owner             Users                @relation(fields: [owner_user_id], references: [id])
  persona_que_abona Personas             @relation("CruceAbona", fields: [persona_que_abona_id], references: [id])
  persona_que_asume Personas             @relation("CruceAsume", fields: [persona_que_asume_deuda_id], references: [id])
  prestamo_destino  Prestamos?           @relation(fields: [prestamo_destino_id], references: [id])
  periodo_destino   PeriodosRecurrentes? @relation(fields: [periodo_recurrente_destino_id], references: [id])

  movimientos MovimientosDeudaPersona[]
}

model MovimientosDeudaPersona {
  id                          BigInt    @id @default(autoincrement())
  owner_user_id               BigInt
  persona_id                  BigInt
  fecha_movimiento            DateTime  @db.Date
  periodo_imputacion          String    @db.Char(7)
  tipo_movimiento             String    @db.VarChar
  signo                       Int       @db.SmallInt
  monto                       Decimal   @db.Decimal
  cuota_detalle_id            BigInt?
  responsable_compra_id       BigInt?
  prestamo_id                 BigInt?
  periodo_recurrente_id       BigInt?
  transaccion_id              BigInt?
  cruce_deuda_id              BigInt?
  cargo_recurrente_persona_id BigInt?
  obligacion_mes_id           BigInt?
  cobro_puntual_id            BigInt?
  appsheet_row_id             String?   @unique
  concepto                    String    @db.VarChar
  estado                      String?   @db.VarChar
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)

  owner              Users                       @relation(fields: [owner_user_id], references: [id])
  persona            Personas                    @relation(fields: [persona_id], references: [id])
  cuota_detalle      CuotasDetalle?              @relation(fields: [cuota_detalle_id], references: [id])
  responsable_compra ResponsablesComprasCredito? @relation(fields: [responsable_compra_id], references: [id])
  prestamo           Prestamos?                  @relation(fields: [prestamo_id], references: [id])
  periodo_recurrente PeriodosRecurrentes?        @relation(fields: [periodo_recurrente_id], references: [id])
  transaccion        Transacciones?              @relation(fields: [transaccion_id], references: [id])
  cruce_deuda        CrucesDeuda?                @relation(fields: [cruce_deuda_id], references: [id])
  cargo_recurrente   CargosRecurrentesPersona?   @relation(fields: [cargo_recurrente_persona_id], references: [id])
  obligacion_mes     ObligacionesMes?            @relation(fields: [obligacion_mes_id], references: [id])
  cobro_puntual      CobrosPuntuales?            @relation(fields: [cobro_puntual_id], references: [id])

  reportes_pago ReportesPagoPersona[]
  objeciones_cobro ObjecionesCobro[]
}

/// Cargos o abonos mensuales recurrentes a una persona, vitalicios o por X meses (sql/002).
/// Los asientos del mes se generan de forma idempotente en `MovimientosDeudaPersona`.
model CargosRecurrentesPersona {
  id                 BigInt    @id @default(autoincrement())
  owner_user_id      BigInt
  persona_id         BigInt
  concepto           String    @db.VarChar
  valor_mensual      Decimal   @db.Decimal(15, 2)
  naturaleza         String    @default("CARGO_A_COBRAR") @db.VarChar
  modalidad_duracion String    @default("INDEFINIDO") @db.VarChar
  numero_meses       Int?
  mes_inicio         String    @db.Char(7)
  mes_fin            String?   @db.Char(7)
  cuotas_generadas   Int       @default(0)
  dia_cobro          Int       @default(1) @db.SmallInt
  activo             Boolean   @default(true)
  estado             String    @default("ACTIVO") @db.VarChar
  notas              String?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  owner   Users    @relation(fields: [owner_user_id], references: [id])
  persona Personas @relation(fields: [persona_id], references: [id])

  movimientos MovimientosDeudaPersona[]
}

/// Cobro de un gasto repartido entre varias personas (recibo de la luz, mercado, una fiesta…). Cada participante
/// distinto del propietario genera un cargo CARGO_COBRO_PUNTUAL en el sub-ledger (sql/003).
model CobrosPuntuales {
  id                 BigInt    @id @default(autoincrement())
  owner_user_id      BigInt
  concepto           String    @db.VarChar
  categoria          String    @default("OTRO") @db.VarChar
  fecha_gasto        DateTime  @db.Date
  periodo_imputacion String    @db.Char(7)
  monto_total        Decimal   @db.Decimal(15, 2)
  modo_division      String    @default("IGUAL") @db.VarChar
  transaccion_id     BigInt?
  compra_credito_id  BigInt?
  notificacion_id    BigInt?
  notas              String?
  estado             String    @default("ACTIVO") @db.VarChar
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  owner        Users                 @relation(fields: [owner_user_id], references: [id])
  transaccion  Transacciones?        @relation(fields: [transaccion_id], references: [id])
  compra       ComprasCredito?       @relation(fields: [compra_credito_id], references: [id])
  notificacion NotificacionesCorreo? @relation(fields: [notificacion_id], references: [id])

  participantes CobrosPuntualesPersonas[]
  movimientos   MovimientosDeudaPersona[]
}

model CobrosPuntualesPersonas {
  id         BigInt   @id @default(autoincrement())
  cobro_id   BigInt
  persona_id BigInt
  monto      Decimal  @db.Decimal(15, 2)
  porcentaje Decimal? @db.Decimal(8, 4)
  es_propio  Boolean  @default(false)

  cobro   CobrosPuntuales @relation(fields: [cobro_id], references: [id], onDelete: Cascade)
  persona Personas        @relation(fields: [persona_id], references: [id])

  @@unique([cobro_id, persona_id])
}

/// Enlace público (por token) con la liquidación de una persona en un periodo. `snapshot` es lo que ella ve.
model EnlacesCobroPersona {
  id                 BigInt    @id @default(autoincrement())
  owner_user_id      BigInt
  persona_id         BigInt
  periodo            String    @db.Char(7)
  token              String    @unique @db.VarChar(64)
  snapshot           Json
  snapshot_at        DateTime  @default(now()) @db.Timestamptz(6)
  mensaje            String?
  instrucciones_pago String?
  expira_at          DateTime  @db.Timestamptz(6)
  revocado           Boolean   @default(false)
  vistas             Int       @default(0)
  ultima_vista_at    DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  owner   Users    @relation(fields: [owner_user_id], references: [id])
  persona Personas @relation(fields: [persona_id], references: [id])

  reportes ReportesPagoPersona[]
  objeciones ObjecionesCobro[]

  @@unique([owner_user_id, persona_id, periodo])
}

/// Pago que la persona dice haber hecho desde el enlace público, con su comprobante; el propietario lo aprueba o rechaza.
model ReportesPagoPersona {
  id                 BigInt    @id @default(autoincrement())
  owner_user_id      BigInt
  enlace_id          BigInt?
  persona_id         BigInt
  periodo            String    @db.Char(7)
  monto_reportado    Decimal   @db.Decimal(15, 2)
  fecha_pago         DateTime  @db.Date
  medio              String?   @db.VarChar
  referencia         String?   @db.VarChar
  comentario         String?
  comprobante_nombre String?   @db.VarChar
  comprobante_tipo   String?   @db.VarChar
  comprobante_tamano Int?
  comprobante        Bytes?
  estado             String    @default("PENDIENTE") @db.VarChar
  monto_aprobado     Decimal?  @db.Decimal(15, 2)
  saldo_al_reportar  Decimal?  @db.Decimal(15, 2)
  motivo_rechazo     String?
  cuenta_destino_id  BigInt?
  transaccion_id     BigInt?
  movimiento_id      BigInt?
  revisado_at        DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  owner          Users                    @relation(fields: [owner_user_id], references: [id])
  enlace         EnlacesCobroPersona?     @relation(fields: [enlace_id], references: [id])
  persona        Personas                 @relation(fields: [persona_id], references: [id])
  cuenta_destino CuentasFinancieras?      @relation(fields: [cuenta_destino_id], references: [id])
  transaccion    Transacciones?           @relation(fields: [transaccion_id], references: [id])
  movimiento     MovimientosDeudaPersona? @relation(fields: [movimiento_id], references: [id])
}

/// Dónde puede pagarte cada persona (cuenta, Nequi, Daviplata, llave Bre-B…): se muestra en el enlace público con un botón «Copiar».
model MetodosPagoUsuario {
  id            BigInt   @id @default(autoincrement())
  owner_user_id BigInt
  tipo          String   @db.VarChar(20)
  entidad       String   @db.VarChar(80)
  numero        String   @db.VarChar(60)
  titular       String?  @db.VarChar(120)
  documento     String?  @db.VarChar(30)
  instrucciones String?  @db.VarChar(500)
  cuenta_id     BigInt?
  qr            Bytes?
  qr_tipo       String?  @db.VarChar(40)
  qr_tamano     Int?
  activo        Boolean  @default(true)
  orden         Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  owner  Users               @relation(fields: [owner_user_id], references: [id])
  cuenta CuentasFinancieras? @relation(fields: [cuenta_id], references: [id])

  @@index([owner_user_id, activo, orden], map: "idx_metodos_pago_owner")
}

/// La persona objeta un cobro (o el total) desde su enlace; el propietario la resuelve: mantiene, ajusta, excluye o descuenta.
model ObjecionesCobro {
  id              BigInt    @id @default(autoincrement())
  owner_user_id   BigInt
  enlace_id       BigInt
  persona_id      BigInt
  periodo         String    @db.Char(7)
  alcance         String    @db.VarChar(5)
  item_clave      String?   @db.VarChar(40)
  item_concepto   String?   @db.VarChar(255)
  item_monto      Decimal?  @db.Decimal(15, 2)
  comentario      String    @db.VarChar(1000)
  monto_propuesto Decimal?  @db.Decimal(15, 2)
  estado          String    @default("ABIERTA") @db.VarChar(10)
  resolucion      String?   @db.VarChar(12)
  respuesta       String?   @db.VarChar(1000)
  monto_ajuste    Decimal?  @db.Decimal(15, 2)
  movimiento_id   BigInt?
  resuelta_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  owner      Users                    @relation(fields: [owner_user_id], references: [id])
  enlace     EnlacesCobroPersona      @relation(fields: [enlace_id], references: [id], onDelete: Cascade)
  persona    Personas                 @relation(fields: [persona_id], references: [id])
  movimiento MovimientosDeudaPersona? @relation(fields: [movimiento_id], references: [id])

  @@index([owner_user_id, estado, created_at(sort: Desc)], map: "idx_objeciones_owner_estado")
  @@index([enlace_id], map: "idx_objeciones_enlace")
}

// ─────────────────────────────────────────────────────────────────────────────
// Vistas (sección 4.2 del documento de BD): NO se modelan.
// `vw_ResumenObligacionesMes` y `vw_AportesDiaResumen` no existen (o tienen otra forma) en el Supabase real, y
// leerlas rompía /api/obligaciones-mes. Sus resúmenes se calculan en ObligacionesAportesService sobre las tablas base.
// ─────────────────────────────────────────────────────────────────────────────


model EventosLiquidacionGrupal {
  id            BigInt   @id @default(autoincrement())
  owner_user_id BigInt
  nombre        String   @db.VarChar(200)
  fecha_inicio  DateTime? @db.Date
  fecha_fin     DateTime? @db.Date
  estado        String   @default("ABIERTO") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  owner         Users @relation(fields: [owner_user_id], references: [id])
  participantes ParticipantesEventoGrupal[]
  gastos        GastosEventoGrupal[]
}

model ParticipantesEventoGrupal {
  id                 BigInt  @id @default(autoincrement())
  evento_id          BigInt
  persona_id         BigInt
  alias_bloque       String? @db.VarChar(120)
  peso_participacion Decimal @default(1.0) @db.Decimal(8, 3)

  evento  EventosLiquidacionGrupal @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  persona Personas                 @relation(fields: [persona_id], references: [id])

  gastos_pagados GastosEventoGrupal[]

  @@unique([evento_id, persona_id])
}

model GastosEventoGrupal {
  id                         BigInt   @id @default(autoincrement())
  evento_id                  BigInt
  descripcion                String   @db.VarChar(255)
  monto_total                Decimal  @db.Decimal(15, 2)
  pagado_por_participante_id BigInt
  tipo_division              String   @default("PARTES_IGUALES") @db.VarChar(20)
  division_json              Json?
  fecha                      DateTime? @db.Date
  created_at                 DateTime @default(now()) @db.Timestamptz(6)

  evento     EventosLiquidacionGrupal  @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  pagado_por ParticipantesEventoGrupal @relation(fields: [pagado_por_participante_id], references: [id])
}


model AportesColaborativosCuota {
  id                   BigInt   @id @default(autoincrement())
  cuota_detalle_id     BigInt
  compra_credito_id    BigInt
  aportante_persona_id BigInt
  monto_aportado       Decimal  @db.Decimal(15, 2)
  fecha_aporte         DateTime @default(now()) @db.Date
  modalidad_entrega    String   @default("TRANSFERIDO_A_MI") @db.VarChar(30)
  transaccion_id       BigInt?
  comprobante_url      String?
  observaciones        String?
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  cuota_detalle CuotasDetalle  @relation(fields: [cuota_detalle_id], references: [id], onDelete: Cascade)
  compra        ComprasCredito @relation(fields: [compra_credito_id], references: [id], onDelete: Cascade)
  aportante     Personas       @relation(fields: [aportante_persona_id], references: [id])
  transaccion   Transacciones? @relation(fields: [transaccion_id], references: [id])
}


model AbonosPrestamoPasivo {
  id                    BigInt   @id @default(autoincrement())
  prestamo_id           BigInt
  owner_user_id         BigInt
  monto                 Decimal  @db.Decimal(15, 2)
  fecha_hora_pago       DateTime @default(now()) @db.Timestamptz(6)
  cuenta_origen_id      BigInt?
  cuenta_destino_detalle String? @db.VarChar(150)
  comprobante           Bytes?
  comprobante_nombre    String?  @db.VarChar(255)
  comprobante_tipo      String?  @db.VarChar(40)
  comprobante_tamano    Int?
  comprobante_url       String?
  transaccion_id        BigInt?
  observaciones         String?
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  prestamo      Prestamos           @relation(fields: [prestamo_id], references: [id], onDelete: Cascade)
  owner         Users               @relation(fields: [owner_user_id], references: [id])
  cuenta_origen CuentasFinancieras? @relation(fields: [cuenta_origen_id], references: [id])
  transaccion   Transacciones?      @relation(fields: [transaccion_id], references: [id])
}
