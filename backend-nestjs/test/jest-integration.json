{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 60000,
  "testEnvironment": "node"
}
