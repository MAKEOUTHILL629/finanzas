# ====================================
# FINANZAS API (NestJS) - VARIABLES DE ENTORNO
# ====================================
# Plantilla: copiar a `.env` y completar. NO subir valores reales al repositorio.

# --- Base de datos (Supabase / PostgreSQL) ---
# DATABASE_URL: conexión de la aplicación a través del pooler de Supabase (pgBouncer, puerto 6543).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: conexión directa (puerto 5432). La usa el CLI de Prisma (`prisma db pull`, `prisma validate`).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Alternativa: variables del contenedor Scala (se derivan solas si no defines DATABASE_URL) ---
# DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
# DB_USER=postgres.<PROJECT_REF>
# DB_PASSWORD=<DB_PASSWORD>
# DB_POOL_SIZE=5

# --- Seguridad / JWT ---
# Debe ser EL MISMO secreto que usa hoy Play Framework (APP_SECRET / play.http.secret.key) para que las sesiones
# activas de Angular sigan siendo válidas tras el cambio de backend. Generar con: openssl rand -base64 64
JWT_SECRET=your_application_secret_key_here_minimum_32_characters_long
# (Compatibilidad drop-in: si no defines JWT_SECRET se usa APP_SECRET.)
# APP_SECRET=
# Vigencia del token en segundos (igual que jwt.expiration de Play).
JWT_EXPIRATION=3600

# --- Servidor ---
# Mismo puerto que la aplicación Play en AWS (reemplazo directo).
PORT=9000
# Orígenes permitidos por CORS, separados por coma. Por defecto: localhost:4200/3000, makefinanzas.lat y CloudFront.
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,https://www.makefinanzas.lat,https://makefinanzas.lat,https://d2k6anvt1vxcuu.cloudfront.net

# --- Webhook de correos Bancolombia (Google Apps Script → POST /api/notificaciones-correo/sync-batch) ---
# El script envía `x-webhook-secret: <WEBHOOK_SECRET>` (mínimo 16 caracteres; generar con: openssl rand -hex 32).
# Sin ese header la ruta exige el JWT normal, así que Angular también puede usarla.
WEBHOOK_SECRET=change_me_to_a_random_secret_of_at_least_16_chars
# Usuario (Users.id) a cuyo nombre se registran los correos recibidos con el secreto del webhook (multi-tenant: owner_user_id).
DEFAULT_OWNER_USER_ID=1
# Huso horario de las fechas/horas de los correos (Colombia no tiene horario de verano).
SYNC_TZ_OFFSET=-05:00
# TRM de respaldo para compras en USD cuando el usuario aún no tiene ninguna compra en USD de la que tomarla.
# Sin TRM el correo en USD queda PENDIENTE (motivo `trm_no_disponible`) hasta conciliarlo.
# DEFAULT_TRM_USD=4000

# --- Opcional ---
# Pausa (ms) entre sitios bancarios durante POST /api/tarjetas/actualizar-tasas (legacy: 2000).
SCRAPING_DELAY_MS=2000
# Zona horaria para "hoy" (estado Pagado/Pendiente de las cuotas). Colombia: America/Bogota.
TZ=America/Bogota
