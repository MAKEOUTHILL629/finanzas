# ====================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ====================================
# Este archivo es una plantilla.
# NO incluir valores reales de producción aquí.

# Docker Hub
DOCKER_USERNAME=tu_username_dockerhub

# Base de Datos (Supabase)
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USER=postgres.cnwavyhswdsthschjkxg
DB_PASSWORD=your_db_password_here

# Seguridad de la Aplicación
# Generar con: openssl rand -base64 64
APP_SECRET=your_application_secret_key_here_minimum_32_characters_long

# JWT Configuration
JWT_EXPIRATION=3600

# Play Framework
PLAY_HTTP_CONTEXT=/

# Java Options para EC2 t2.micro (1GB RAM)
# Dejar ~300MB para el sistema operativo
JAVA_OPTS=-Xmx700m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+UseStringDeduplication

# Logging
LOG_LEVEL=INFO

# Puerto de la aplicación
HTTP_PORT=9000

