# Opcional — variables SOLO de la API NestJS para docker-compose.local.yml.
# Copiar a `.env.local` (ignorado por git). La conexión a Supabase y el secreto JWT salen del `.env` de Scala.

# Webhook de correos Bancolombia (Google Apps Script → POST /api/notificaciones-correo/sync-batch).
# Mínimo 16 caracteres. Sin esta variable el webhook por header queda deshabilitado (solo JWT).
# WEBHOOK_SECRET=change_me_to_a_random_secret_of_at_least_16_chars
# Users.id a cuyo nombre se registran los correos recibidos con el secreto del webhook.
# DEFAULT_OWNER_USER_ID=1

# TRM de respaldo para compras en USD cuando el usuario todavía no tiene ninguna.
# DEFAULT_TRM_USD=4000

# Tamaño del pool de conexiones a Supabase (por defecto 5, igual que HikariCP en Scala).
# DB_POOL_SIZE=5
